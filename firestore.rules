rules_version = '2';

// ===============================================================
// Assumed Data Model — Youth for Environment (YFE)
// Firebase Project: youthforenvironment
// ===============================================================
//
// WARNING / TEMPORARY AUTHENTICATION NOTE:
// Currently, admin.html uses a local client-side password gate without
// Firebase Authentication. Therefore, write operations below currently
// rely on strict schema/type/size validation without `isAdmin()`.
// BEFORE BROAD PRODUCTION DEPLOYMENT:
//   1. Enable Firebase Authentication (e.g., Email/Password for admins).
//   2. Assign an `admin: true` custom claim (or maintain an admins list).
//   3. Gate all `create`, `update`, and `delete` rules with `isAdmin()`.
//
// Collection: site_content
// Document ID: content key (e.g., 'about_text1', 'stat1_num', 'join_description')
// Fields:
//   - value: string (required, 0..10000 chars) - CMS text/stat value
//
// Collection: societies
// Document ID: society ID ('YFC', 'YFA', 'YFAR')
// Fields:
//   - name: string (required, 1..200 chars) - Society display name
//   - description: string (required, 0..10000 chars) - About text
//   - achievements: string (required, 0..10000 chars) - Achievements text
//
// Collection: active_regions
// Document ID: region/country/state code (e.g., 'BR-GO', 'br', 'us')
// Fields:
//   - name: string (required, 1..200 chars) - Region display name or code
//
// Collection: events
// Document ID: auto-generated ID
// Fields:
//   - title: string (required, 1..200 chars) - Event title
//   - date: string (required, 1..100 chars) - Event date label
//   - location: string (required, 1..200 chars) - Event location or platform
//   - tag: string (required, 1..50 chars) - Event category/type tag
//   - description: string (required, 0..5000 chars) - Event summary
//   - created_at: timestamp or number (required, immutable on update)
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================

    // Ready for Firebase Auth integration:
    function isAuthenticated() {
      return request.auth != null;
    }

    // Ready for Firebase Auth RBAC (requires `admin: true` custom claim):
    function isAdmin() {
      return isAuthenticated() && request.auth.token.admin == true;
    }

    // Validate required fields exist
    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    // Validate that the document contains only the allowed fields
    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    // Validate string type and length bounds (prevents 1MB DoS payloads)
    function validStringLength(data, field, minLen, maxLen) {
      return data[field] is string &&
             data[field].size() >= minLen &&
             data[field].size() <= maxLen;
    }

    // Ensure immutable fields are not modified on update
    function areImmutableFieldsUnchanged(fields) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(fields);
    }

    // ===============================================================
    // Domain Validators (Used in BOTH create and update)
    // ===============================================================

    function isValidSiteContent(data) {
      return hasRequiredFields(['value']) &&
             hasOnlyAllowedFields(['value']) &&
             validStringLength(data, 'value', 0, 10000);
    }

    function isValidSocietyId(societyId) {
      return societyId in ['YFC', 'YFA', 'YFAR'];
    }

    function isValidSociety(data) {
      return hasRequiredFields(['name', 'description', 'achievements']) &&
             hasOnlyAllowedFields(['name', 'description', 'achievements']) &&
             validStringLength(data, 'name', 1, 200) &&
             validStringLength(data, 'description', 0, 10000) &&
             validStringLength(data, 'achievements', 0, 10000);
    }

    function isValidRegionId(regionId) {
      return regionId is string &&
             regionId.size() >= 2 &&
             regionId.size() <= 20 &&
             regionId.matches('^[A-Za-z0-9_-]+$');
    }

    function isValidActiveRegion(data) {
      return hasRequiredFields(['name']) &&
             hasOnlyAllowedFields(['name']) &&
             validStringLength(data, 'name', 1, 200);
    }

    function isValidEvent(data) {
      return hasRequiredFields(['title', 'date', 'location', 'tag', 'description', 'created_at']) &&
             hasOnlyAllowedFields(['title', 'date', 'location', 'tag', 'description', 'created_at']) &&
             validStringLength(data, 'title', 1, 200) &&
             validStringLength(data, 'date', 1, 100) &&
             validStringLength(data, 'location', 1, 200) &&
             validStringLength(data, 'tag', 1, 50) &&
             validStringLength(data, 'description', 0, 5000) &&
             (data.created_at is timestamp || (data.created_at is number && data.created_at >= 0));
    }

    // ===============================================================
    // Collection Rules
    // ===============================================================

    // Public website CMS content (about texts, join description, stats)
    match /site_content/{key} {
      allow read: if true;
      // TODO: Restrict create/update to `isAdmin() && ...` once Firebase Auth is enabled
      allow create, update: if key.size() >= 1 && key.size() <= 100 &&
                               isValidSiteContent(request.resource.data);
      allow delete: if false;
    }

    // Public society profiles (YFC, YFA, YFAR)
    match /societies/{societyId} {
      allow read: if true;
      // TODO: Restrict create/update to `isAdmin() && ...` once Firebase Auth is enabled
      allow create, update: if isValidSocietyId(societyId) &&
                               isValidSociety(request.resource.data);
      allow delete: if false;
    }

    // Public active map regions (toggled on/off by admin)
    match /active_regions/{regionId} {
      allow read: if true;
      // TODO: Restrict create/update/delete to `isAdmin()` once Firebase Auth is enabled
      allow create, update: if isValidRegionId(regionId) &&
                               isValidActiveRegion(request.resource.data);
      allow delete: if isValidRegionId(regionId);
    }

    // Public events & actions schedule
    match /events/{eventId} {
      allow read: if true;
      // TODO: Restrict create/update/delete to `isAdmin()` once Firebase Auth is enabled
      allow create: if isValidEvent(request.resource.data);
      allow update: if isValidEvent(request.resource.data) &&
                       areImmutableFieldsUnchanged(['created_at']);
      allow delete: if true;
    }

    // Default deny for all other collections and subcollections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
